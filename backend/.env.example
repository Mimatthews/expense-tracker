# Backend configuration (all optional — sensible defaults are used)

# Where the SQLite file lives. Defaults to backend/data/expenses.db
# DATABASE_PATH=./data/expenses.db

# Reseed demo data on startup when the database is empty
# DEMO_MODE=1

# Comma-separated origins allowed to call the API (the Vite dev proxy means
# you usually don't need this in development)
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
